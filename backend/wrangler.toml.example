name = "taxipro-dispatch-v2-api"
main = "worker.js"
compatibility_date = "2026-10-01"
workers_dev = true

# Create D1 database: npx wrangler d1 create taxipro-dispatch-v2
# Put real database_id from the output here.
[[d1_databases]]
binding = "DB"
database_name = "taxipro-dispatch-v2"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
# Must match the exact published GitHub Pages origin (no trailing slash).
APP_ORIGIN = "https://sero91ak.github.io"

# Optional private object storage for driver PDFs/images and signatures.
# Create a PRIVATE R2 bucket and then supply the actual bucket name.
# Do not publicly expose the bucket or use public r2.dev URLs.
# This binding is NOT active until configured and deployed.
#
# [[r2_buckets]]
# binding = "ATTACHMENTS"
# bucket_name = "taxipro-private-evidence"

# TaxiPro 2.4: synchronizer remains disabled by default. All authentication
# credentials belong ONLY in Cloudflare Worker secrets, never this file.
ENABLE_GOOGLE_SYNC = "false"
#
# After deploying a private HTTPS Worker, configuring DB/R2 and verifying OAuth:
# use an explicitly enabled scheduled trigger for background refresh.
# With Cloudflare crons a quarter-hourly UTC tick can be configured by:
# [triggers]
# crons = ["*/15 * * * *"]
#
# Suggested secret names for separate accounts:
# GOOGLE_TAXI_CLIENT_ID, GOOGLE_TAXI_CLIENT_SECRET,
# GOOGLE_TAXI_REFRESH_TOKEN, GOOGLE_TAXI_CALENDAR_ID
# GOOGLE_MASTER_CLIENT_ID, GOOGLE_MASTER_CLIENT_SECRET,
# GOOGLE_MASTER_REFRESH_TOKEN, GOOGLE_MASTER_SHEET_ID
# GOOGLE_CONTACTS_CLIENT_ID, GOOGLE_CONTACTS_CLIENT_SECRET,
# GOOGLE_CONTACTS_REFRESH_TOKEN
#
# Never put real patient information, credentials, tokens or account addresses
# into repository sources. Respect Google OAuth quotas and Cloudflare free limits.
